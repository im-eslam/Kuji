Options -Indexes
FallbackResource /api/index.php

# Block direct access to everything except index.php (secrets, SQL, source files).
<FilesMatch "(^\.|\.(env|sql|md|example|log|ini|json|lock)$)">
    Require all denied
</FilesMatch>
<FilesMatch "^(?!index\.php$).+\.php$">
    Require all denied
</FilesMatch>
